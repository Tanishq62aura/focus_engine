# ===========================================================================
# Focus Engine – Environment Configuration
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. DATABASE LAYER (SQLite for local offline dev vs hosted Supabase Postgres)
# ---------------------------------------------------------------------------
# Local SQLite default (offline development):
DATABASE_URL=sqlite:///./focus_system.db

# Hosted Supabase PostgreSQL connection string (Direct connection, port 5432):
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Hosted Supabase Connection Pooler (Transaction mode, port 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# 2. AUTHENTICATION & SUPABASE OAUTH SETTINGS
# ---------------------------------------------------------------------------
# Set to 'true' to bypass JWT verification for local/offline testing without auth tokens
# Set to 'false' in staging/production to enforce Supabase / Google OAuth user isolation
AUTH_DISABLED=true

# Supabase Project credentials (find under Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase JWT Secret (find under Project Settings -> API -> JWT Settings)
# Used to cryptographically verify Supabase & Google OAuth Bearer tokens (HS256)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Default fallback user ID when AUTH_DISABLED=true or during dev mock mode
DEV_USER_ID=dev-user

# ---------------------------------------------------------------------------
# 3. GEMINI AI VERIFICATION & VIVA DEFENSE
# ---------------------------------------------------------------------------
# Google Gemini API key for AI-powered viva generation and excuse auditing
# (If missing, the system gracefully degrades to built-in heuristic verification)
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# 4. MIGRATION CONFIGURATION
# ---------------------------------------------------------------------------
# Target connection used by scripts/migrate_sqlite_to_supabase.py
TARGET_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DEFAULT_USER_ID=dev-user

# ---------------------------------------------------------------------------
# 5. MOBILE DISPATCHER (ntfy.sh Webhooks / Samsung Modes & Routines)
# ---------------------------------------------------------------------------
# Webhook topic and server for DND / grayscale mobile automation
NTFY_TOPIC=focus_engine_alerts
NTFY_SERVER=https://ntfy.sh

