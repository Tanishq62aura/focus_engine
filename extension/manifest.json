{
  "manifest_version": 3,
  "name": "Focus Engine Tracker",
  "version": "1.0.1",
  "description": "Dual Chrome/Edge MV3 telemetry service worker with alarm scheduling, active domain inspection, and auth sync for Focus Engine.",

  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "activeTab",
    "notifications"
  ],

  "host_permissions": [
    "https://focus-engine.onrender.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://focus-engine.onrender.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Focus Engine Tracker",
    "default_popup": "popup.html"
  }
}
